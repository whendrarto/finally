{
  "name": "finally-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "Playwright E2E tests for FinAlly",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "docker": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from playwright"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
